# 복사해서 .env 로 이름 바꾼 뒤 값을 채우세요 (.env 는 절대 공유 금지)
BOT_TOKEN=여기에_BotFather_토큰
# 관리자 텔레그램 숫자 ID (쉼표로 여러 명). 모르면 봇에게 /myid 입력
ADMIN_IDS=
# 1:1 문의 연결할 텔레그램 아이디 (@ 제외)
SUPPORT_USERNAME=
# 누드티비 바로가기 링크
SCORE_URL=
# 사이트 주소 (이벤트·인기글 링크에 쓰임)
SITE_URL=
# 게시판 글 가져오기
BOARD_API=https://게시판-서버-주소/api/bulletin-board
# 내 글만 보여주려면 게시판 닉네임을 정확히 입력 (비우면 전체 최신글)
AUTHOR_NICKNAME=
BOARD_NAME=sports_talk
POST_URL_TEMPLATE=https://사이트주소/community/sports-talk/{id}
# 경기결과를 가져올 공개 텔레그램 채널 (t.me/ 뒤 이름)
RESULT_CHANNEL=
# /start 때 먼저 보낼 스티커 번호 (봇에게 스티커를 보내면 알려줌, 비우면 안 보냄)
STICKER_ID=
# 버튼 아이콘(커스텀 이모지 번호, 비우면 아이콘 없음)
ICON_PICKS=
ICON_SCORE=
ICON_HOME=
ICON_SUPPORT=
# 누드티비 AI 연결 버튼 링크 (비우면 버튼 숨김)
AI_URL=
# AI 대화용 Anthropic API 키 (비우면 AI 꺼짐, 1:1에서 글을 치면 메뉴만 표시)
ANTHROPIC_API_KEY=
# 사람당 하루 AI 대화 횟수 (0 = 제한 없음)
AI_DAILY_LIMIT=30
# 1 = 채널에 없는 리그는 네이버로 채움, 0 = 채널 점수만 사용
SCORE_NAVER_BACKUP=1
# 1 = 텔레그램 채널 결과를 우선 사용 (기본 0 = 라이브스코어만)
SCORE_USE_CHANNEL=0
ICON_FAV=
ICON_OFFICIAL=
ICON_EVENTS=
# 이벤트 첫 설치 때 문구에 들어갈 그룹방 링크
EVENT_GROUP_LINK=
# 플래시스코어 접속 키(사이트가 쓰는 공개 값)
FLASHSCORE_SIGN=
